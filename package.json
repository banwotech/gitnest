{
  "name": "gitnest",
  "version": "0.1.0",
  "private": true,
  "description": "Git version management for the AI era.",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "GitNest",
  "repository": {
    "type": "git",
    "url": "https://github.com/banwotech/gitnest.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "monaco-editor": "0.57.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "41.3.0",
    "electron-builder": "26.8.1",
    "typescript": "6.0.2",
    "vite": "8.0.4"
  },
  "build": {
    "appId": "dev.gitnest.desktop",
    "productName": "GitNest",
    "artifactName": "GitNest-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  }
}
